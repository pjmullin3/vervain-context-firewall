{
  "name": "vervain-context-firewall",
  "version": "0.1.0",
  "private": true,
  "description": "Vervain Context Firewall: pre-inference context admission, release-time epoch recheck, bounded causal receipts, and reference scoped-attention math.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx src/server/dev.ts",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:adversarial": "vitest run tests/adversarial",
    "test:live": "ALLOW_LIVE_GEMINI=1 vitest run tests/live",
    "test:e2e": "playwright test",
    "proof:paired": "tsx scripts/run-paired-proof.ts",
    "verify:bundle": "tsx scripts/verify-bundle-hygiene.ts",
    "verify:claims": "tsx scripts/verify-claim-discipline.ts",
    "verify:evidence": "PYTHONDONTWRITEBYTECODE=1 python3 verification/run_local_gates.py"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@xyflow/react": "^12.11.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.12.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.15.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
