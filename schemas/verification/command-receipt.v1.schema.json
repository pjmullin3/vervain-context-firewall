{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vervain.security/schemas/verification/command-receipt.v1.schema.json",
  "title": "Vervain Bounded Command Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "run_id",
    "step_id",
    "command",
    "exit_code",
    "expected_nonzero_control",
    "signal",
    "started_at",
    "finished_at",
    "duration_ms",
    "git",
    "environment",
    "host_id_digest",
    "stdout_sha256",
    "stderr_sha256",
    "stdout_bytes",
    "stderr_bytes",
    "stdout_relpath",
    "stderr_relpath",
    "expected_files",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": { "const": "command-receipt.v1" },
    "receipt_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:/-]+$" },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:/-]+$" },
    "step_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:/-]+$" },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "argv_sanitized", "argv_redacted_indices", "working_dir_digest"],
      "properties": {
        "executable": { "type": "string", "minLength": 1, "maxLength": 256 },
        "argv_sanitized": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "argv_redacted_indices": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "working_dir_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "exit_code": { "type": "integer", "minimum": -255, "maximum": 255 },
    "expected_nonzero_control": { "type": "boolean" },
    "signal": { "type": ["integer", "null"] },
    "started_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$" },
    "finished_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$" },
    "duration_ms": { "type": "number", "minimum": 0, "maximum": 1e15 },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_sha", "git_dirty_before", "git_dirty_after", "dirty_entries_count", "branch"],
      "properties": {
        "git_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "git_dirty_before": { "type": ["boolean", "null"] },
        "git_dirty_after": { "type": ["boolean", "null"] },
        "dirty_entries_count": { "type": ["integer", "null"], "minimum": 0 },
        "branch": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safe_env_vars", "redacted_env_keys", "env_digest_sha256"],
      "properties": {
        "safe_env_vars": {
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 512 }
        },
        "redacted_env_keys": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "env_digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "host_id_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stdout_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stderr_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stdout_bytes": { "type": "integer", "minimum": 0 },
    "stderr_bytes": { "type": "integer", "minimum": 0 },
    "stdout_relpath": { "type": ["string", "null"], "maxLength": 256 },
    "stderr_relpath": { "type": ["string", "null"], "maxLength": 256 },
    "expected_files": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "sha256", "size_bytes", "present_exactly_once"],
        "properties": {
          "relative_path": { "type": "string", "minLength": 1, "maxLength": 256 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "present_exactly_once": { "type": "boolean" }
        }
      }
    },
    "receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
