{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vervain.security/schemas/verification/trust-root.v1.schema.json",
  "title": "Vervain Verifier Explicit Trust Root v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trust_root_id", "keys"],
  "properties": {
    "schema_version": { "const": "trust-root.v1" },
    "trust_root_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:/-]+$" },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "algorithm",
          "public_key_b64",
          "status",
          "purpose",
          "not_before",
          "not_after",
          "allow_ephemeral_demo"
        ],
        "properties": {
          "key_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:/-]+$" },
          "algorithm": { "type": "string", "enum": ["ed25519"] },
          "public_key_b64": { "type": "string", "minLength": 32, "maxLength": 256 },
          "status": { "type": "string", "enum": ["active", "revoked"] },
          "purpose": { "type": "string", "enum": ["inference-proof-signing"] },
          "not_before": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$" },
          "not_after": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$" },
          "allow_ephemeral_demo": { "type": "boolean" }
        }
      }
    }
  }
}
