# Server-only Google Gemini configuration (never commit real keys)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Runtime environment: development | test | production
NODE_ENV=development
PORT=8080

# Session signing secret (generate a 32+ byte hex secret in production)
SESSION_SECRET=

# Transport mode:
#   live - calls official Google GenAI SDK; reports provider_unavailable if unconfigured/unreachable
#   mock - uses deterministic synthetic transport (visibly labeled MOCK in UI and receipts)
DEMO_MODE=live

# Set ALLOW_LIVE_GEMINI=1 only when explicitly running bounded live smoke tests
ALLOW_LIVE_GEMINI=0

# Spend and abuse guardrails
MAX_GEMINI_CALLS_PER_SESSION=12
MAX_GEMINI_CALLS_PER_WINDOW=60
RATE_LIMIT_MUTATIONS_PER_MINUTE=20

# Optional self-hosted GPU inference-proof.v1 artifact seam (leave unset before GPU GO -> renders NO GPU RUN RECORDED)
INFERENCE_PROOF_ARTIFACT_PATH=
EVIDENCE_VERIFIER_PYTHONPATH=
INFERENCE_PROOF_TRUST_ROOT_PATH=
INFERENCE_PROOF_REQUIRE_SIGNATURE=0
